# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local cleanup holding area (safe to delete)
/trash/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep examples, never commit real secrets
.env
.env.*
!.env.example
!backend/.env.example
!.env.local.example

# vercel
.vercel

# python / backend
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/                  # single project-wide venv (matches any nesting depth)
data/chroma/

# Large source PDFs — host on Hugging Face, not GitHub
/agri-data/

# Generated client fallback copies (npm run sync-public / build)
/public/data/

# 47 MB ML artifact — regenerate from crop-ml/trainingModel.ipynb
/crop-ml/*.pkl

# typescript
*.tsbuildinfo
next-env.d.ts
