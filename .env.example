# AgriMitra environment template — copy to .env and fill real values.
# NEVER commit the real .env file.

# AI providers — Groq + local ONNX embeddings is the supported default.
GROQ_API_KEY=your_groq_api_key_here
# Optional: only needed if you set LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini.
# GEMINI_API_KEY=your_gemini_api_key_here

# Backend / databases (see backend/.env.example for the full set)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# MongoDB (local docker-compose or Atlas)
MONGODB_URI=mongodb://localhost:27017

# LLM + embeddings: "groq" + "local" is the supported default.
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=local