# AgriMitra backend environment (copy to backend/.env for local runs)
# ---------------------------------------------------------------------
# REQUIRED — LLM provider (chat answers; embeddings are local, no key)
GROQ_API_KEY=""

# Optional — only needed if you set LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# LLM provider selection: "groq" (default, fast + free) or "gemini"
LLM_PROVIDER=groq
GEMINI_MODEL=gemini-2.5-flash
# Groq chat model. allam-2-7b is available but weak in Hindi; gpt-oss-120b
# handles English and Hindi well. If the key cannot reach this model, the
# backend auto-detects another chat model from GET /models.
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: "local" = all-MiniLM-L6-v2 via ONNX (offline, no key — default);
#             "gemini" = embedding API (requires GEMINI_API_KEY + quota)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MongoDB (local docker-compose or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agrimitra

# Vector store (ChromaDB persistent)
# Relative paths are resolved from the repository root.
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=agrimitra_docs
# Drop weak vector matches (cosine distance; lower = more similar)
CHROMA_MAX_DISTANCE=0.75
# Retrieved chunks per chat turn (also the maximum number of source cards)
RAG_TOP_K=5

# App
ENVIRONMENT=development
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trained crop model (scikit-learn RandomForest, joblib artifact)
# Leave empty to use the rule-based recommender fallback.
# CROP_MODEL_PATH=./crop-ml/crop_recommendation_model.pkl

# Timeouts (seconds)
LLM_TIMEOUT_S=25
RETRIEVAL_TIMEOUT_S=10
CHROMA_HTTP_TIMEOUT_S=30

# Chat abuse protection: max requests per client IP per window
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_S=60